# JCR Investments Terminal — Environment Configuration
# Copy this file to .env and fill in your values

# IBKR MCP endpoint (default shown)
IBKR_MCP_URL=https://api.ibkr.com/v1/api/mcp

# Cash reserve floor — do not deploy below this amount (EUR)
# Used to calculate free capital for DCA orders
# Adjust to your portfolio size (200 for small, 5000+ for larger)
CASH_RESERVE_EUR=200

# DCA rotation groups: assign tickers to groups A/B/C
# Comma-separated ticker lists
DCA_GROUP_A=AAPL,MSFT,ASML
DCA_GROUP_B=NVDA,META,AMZN
DCA_GROUP_C=TSLA,GLD,JNJ
